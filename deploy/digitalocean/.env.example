# Template do .env do droplet. Copie para .env ao lado do compose e
# preencha. Todas as variáveis do .env.example da raiz continuam valendo —
# este arquivo cobre apenas o que muda ao sair do EasyPanel.

# --- Imagens -------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/caiovpinheiro/backend_crm1:latest
FRONTEND_IMAGE=ghcr.io/caiovpinheiro/frontend_crm1:latest

# --- Domínios e TLS ------------------------------------------------------
APP_DOMAIN=crm.eduit.com.br
API_DOMAIN=api.crm.eduit.com.br
ACME_EMAIL=
# Token de leitura/escrita da API da DigitalOcean, usado só pelo desafio
# DNS-01 do certificado wildcard.
DO_AUTH_TOKEN=

# --- Dados ---------------------------------------------------------------
# Use a string de conexão PRIVADA (VPC) do painel, na porta 25060, que é a
# direta. Não use a do pool PgBouncer: prisma-base.ts passa
# `options=-c statement_timeout`, que não atravessa o modo transaction.
DATABASE_URL=postgresql://doadmin:SENHA@private-crm1-pg-nyc3-do-user-0.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Valkey pela VPC. O esquema é rediss:// porque a DigitalOcean exige TLS.
REDIS_URL=rediss://default:SENHA@private-crm1-valkey-nyc3-do-user-0.b.db.ondigitalocean.com:25061

# --- Proxy ---------------------------------------------------------------
# Caddy é o único hop à frente da aplicação.
TRUSTED_PROXY_HOPS=1

# --- URLs públicas -------------------------------------------------------
NEXTAUTH_URL=https://crm.eduit.com.br
BACKEND_PUBLIC_URL=https://api.crm.eduit.com.br
NEXT_PUBLIC_API_BASE_URL=https://api.crm.eduit.com.br
APP_URL=https://crm.eduit.com.br
NEXT_PUBLIC_APP_URL=https://crm.eduit.com.br
TENANT_BASE_DOMAIN=crm.eduit.com.br
NEXT_PUBLIC_TENANT_BASE_DOMAIN=crm.eduit.com.br
TENANT_PROTOCOL=https
AUTH_COOKIE_DOMAIN=.crm.eduit.com.br
AUTH_TRUST_HOST=true

# --- Storage -------------------------------------------------------------
# Enquanto tudo roda num droplet só, o volume local resolve. Estas quatro
# variáveis passam a valer quando o driver de Spaces existir e os workers
# forem para um segundo droplet.
STORAGE_ROOT=/app/storage
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_REGION=nyc3
# SPACES_BUCKET=
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=

# --- Workers -------------------------------------------------------------
# Suprime a gravação em `activity_events` (feed /logs) durante importação.
# Cada linha importada gera 1+ evento (até 8 num update), e essas promises
# fire-and-forget disputam o pool de conexões do worker. NÃO defina aqui:
# este .env é compartilhado por todos os serviços e a API precisa do feed.
# O compose já injeta IMPORT_SKIP_ACTIVITY_LOG=true apenas no worker-etl.
# IMPORT_SKIP_ACTIVITY_LOG=true

# --- Segredos ------------------------------------------------------------
# Reaproveite EXATAMENTE os valores do ambiente atual: trocar KEYRING_SECRET
# torna ilegíveis os tokens de canal já gravados no banco.
NEXTAUTH_SECRET=
AUTH_SECRET=
KEYRING_SECRET=
CRON_SECRET=
METRICS_TOKEN=
