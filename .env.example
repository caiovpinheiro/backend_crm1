# ─── Core / deploy ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Modo de execução do container — direciona o entrypoint:
#   api                 → Next.js standalone server (default; aplica migrations Prisma)
#   worker-whatsapp     → inbox Meta (meta-attach + meta-outbound + sweepers de sessão)
#   worker-campaigns    → disparo de campanha CRM (campaign-dispatch + rodízio / campaign-send)
#   worker-leads        → worker BullMQ para operações em massa de Deals
#                         + ainda consome distribution-drain (Phase A; Phase C remove)
#   worker-distribution → worker BullMQ para distribution-drain
#                         (fila de espera da Distribuição / processPending)
#   worker-etl          → worker BullMQ para importação de contatos (CSV/XLSX)
#   worker-automation   → worker BullMQ para Salesbot/automações (automation-jobs)
#   worker-meta-webhook → worker BullMQ para webhooks Meta (meta-webhook-events)
# Migrations Prisma SÓ rodam quando APP_MODE=api (workers não devem aplicar
# migrations — evita race condition entre serviços do mesmo deploy).
# api-public: Bearer/n8n. Em produção a API privada recusa token eduit_.
APP_MODE=api

# Opcional: definir como 1 desliga `prisma migrate deploy` no arranque do container.
# SKIP_PRISMA_MIGRATE=

# Nome da base no path (…/NOME?…) deve ser a que contém as tabelas do CRM (ex.: db_crm). Outra base na mesma instância (ex.: "banco") pode existir mas estar vazia — migrates falham com "relation … does not exist".
#
# DigitalOcean (prod, mesma VPC do droplet): use SEMPRE o hostname private-*.
# Hostname sem prefixo private- (ou IP público) sai pela internet — só para
# acesso externo ocasional, nunca a partir dos droplets/workers.
# VPC ainda exige TLS: sslmode=require no Postgres e rediss:// no Valkey.
#   DATABASE_URL=postgresql://USER:SENHA@private-crm1-pg-nyc3-do-user-XXXX.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
#   REDIS_URL=rediss://default:SENHA@private-crm1-valkey-nyc3-do-user-XXXX.b.db.ondigitalocean.com:25061
# Replica (opcional): mesmo private-* + sslmode=require.
#   DATABASE_URL_REPLICA=postgresql://USER:SENHA@private-crm1-pg-nyc3-do-user-XXXX.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=
REDIS_URL=
# DATABASE_URL_REPLICA=

# Teto duro de requests autenticados por organização (sliding window 60s).
# Conta: sessão, API token, API pública com organizationId.
# Não conta: webhooks inbound (Meta/Stripe/calls), cron, /api/health, /api/auth, super-admin.
# Sem REDIS_URL o bucket é in-memory por processo (N réplicas = N×teto).
ORG_RATE_LIMIT_RPM=400

# Bearer / n8n: só APP_MODE=api-public aceita token em produção.
# Teto por org (soma de todos os tokens), sliding window 60s. Inbox não usa.
TOKEN_ORG_RATE_LIMIT_RPM=240
# URL devolvida no 401 quando o token bate na API privada.
# API_PUBLIC_BASE_URL=https://integrations.bwipo.com
# Rollback emergencial (aceitar Bearer de novo na API privada):
# ALLOW_BEARER_ON_PRIVATE_API=1

# Teto por sessão cookie (NextAuth) — choke point requireAuth / withOrgContext.
# 600/min bloqueia loop de render (~15 req/s ≈ 900/min) e cabe um dashboard
# com dezenas de APIs por load. Bearer token: TOKEN_ORG_RATE_LIMIT_RPM (lane org).
SESSION_RATE_LIMIT_RPM=600

# ─── Storage de mídias (tenant-scoped) ───────────────────────
# Backend de arquivos (anexos, gravações, avatares, mídias inbound, imports).
#   local  → disco local em STORAGE_ROOT (default; comportamento histórico).
#   s3     → bucket S3-compatible (ex.: DigitalOcean Spaces). Kill switch:
#            volte para `local` e remova as S3_* para restaurar sem redeploy
#            de código.
# Em AMBOS os drivers os bytes são servidos pelo gateway autenticado
# /api/storage/<org>/<bucket>/<file> (valida a org da sessão) — o bucket
# NUNCA deve ser público nem exposto por URL direta.
STORAGE_DRIVER=local
# Obrigatório só com STORAGE_DRIVER=local. Default: <cwd>/storage.
# Em container: /app/storage (volume persistente).
# STORAGE_ROOT=/app/storage
# Obrigatórios só com STORAGE_DRIVER=s3:
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET=
# Opcional: GET/reuse tenta este host se o objeto não estiver no Spaces
# (timeout 700ms). Em prod, só se o arquivo ainda viver no backend legado.
# STORAGE_FALLBACK_URL=

# Numero de proxies confiaveis a frente do app (EasyPanel/Traefik = 1,
# Cloudflare + nginx = 2). Usado por getClientIp para escolher o IP
# real do cliente em X-Forwarded-For e evitar spoofing do rate-limit.
TRUSTED_PROXY_HOPS=1

# URL pública deste backend (NextAuth / cookies / links absolutos gerados no servidor).
NEXTAUTH_URL=https://URL-DO-BACKEND-AQUI

# Use o MESMO valor no frontend (NEXTAUTH_SECRET ou AUTH_SECRET).
NEXTAUTH_SECRET=
AUTH_SECRET=

# true = confiar no Host do proxy (Easypanel / Traefik). false/0 = desliga.
AUTH_TRUST_HOST=true

# Multi-tenant por subdomínio (Kommo-style): https://{slug}.crm.eduit.com.br
# TENANT_BASE_DOMAIN=crm.eduit.com.br
# TENANT_PROTOCOL=https
# Cookie Domain compartilhado entre apex e subdomínios (prod HTTPS).
# Default: .{TENANT_BASE_DOMAIN}. Desligar em local: AUTH_COOKIE_DOMAIN=none
# AUTH_COOKIE_DOMAIN=.crm.eduit.com.br

# ─── E-mail transacional (Mailjet SMTP / Nodemailer) ─────────
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=no-reply@bwipo.com
# SMTP_FROM_NAME=Bwipo
# Alternativa combinada: SMTP_FROM=Bwipo <no-reply@bwipo.com>

# Origens extra no CORS do browser → auth API (além de https://*.{TENANT_BASE_DOMAIN}).
# ALLOWED_ORIGINS=https://URL-DO-FRONTEND-AQUI
# BROWSER_API_CORS_ORIGINS=

# Opcional: URL pública em deploy Vercel (fallback em services/channels).
VERCEL_URL=

# ─── Next / runtime ────────────────────────────────────────────
NEXT_RUNTIME=
LOG_LEVEL=

# ─── SSE ───────────────────────────────────────────────────────
SSE_ENABLE_REDIS_PUBSUB=

# ─── Web Push ─────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── FCM (APK nativo; Spark só Messaging) ─────────────────────
# 0 = desliga envio FCM. JSON da conta de serviço NÃO vai no Git.
# FCM_ENABLED=1
# FCM_PROJECT_ID=crm-app-mobile-6ad4f
# FCM_SERVICE_ACCOUNT_PATH=.secrets/fcm-service-account.json
# Alternativa: FCM_SERVICE_ACCOUNT_JSON com o JSON em uma linha ou base64.

# ─── Meta / WhatsApp / Messenger / Instagram ─────────────────
# META_APP_SECRET e META_WEBHOOK_VERIFY_TOKEN sao compartilhados entre
# WhatsApp Cloud, Messenger e Instagram — todos usam o mesmo App Meta do
# CRM. Configure UMA vez e reaproveite nos tres produtos no painel
# developers.facebook.com.
#
# Callback URLs a configurar no App Meta:
#   - WhatsApp        -> https://<backend>/api/webhooks/meta   (ou scoped por org)
#   - Messenger       -> https://<backend>/api/webhooks/meta/messaging
#   - Instagram       -> https://<backend>/api/webhooks/meta/messaging
# Todos com o mesmo Verify Token (META_WEBHOOK_VERIFY_TOKEN).
#
# Permissoes/scopes necessarios (submeter no App Review antes de ir a
# producao): pages_show_list, pages_messaging, pages_manage_metadata,
# business_management, instagram_basic, instagram_manage_messages.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# phone_number_id extras para o webhook descartar (CSV 4535 já é ignorado no código).
# META_IGNORE_PHONE_NUMBER_IDS=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Login for Business Configuration ID dedicada ao Messenger — criar em
# developers.facebook.com > App > Facebook Login for Business >
# Configurations, com permissoes pages_show_list, pages_messaging,
# pages_manage_metadata, business_management.
NEXT_PUBLIC_META_MESSENGER_CONFIG_ID=
# Instagram Business Login (fluxo direto sem Pagina do FB). Criar em
# developers.facebook.com > App > Instagram > API setup with Instagram Login.
# INSTAGRAM_APP_ID/SECRET podem ser diferentes do META_APP_ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
NEXT_PUBLIC_INSTAGRAM_APP_ID=
META_WHATSAPP_CALL_PERMISSION_ACCEPT_BUTTON_IDS=
META_WHATSAPP_CALL_PERMISSION_ACCEPT_BUTTON_TITLES=
META_WHATSAPP_CALL_PERMISSION_TEMPLATE=
META_WHATSAPP_CALL_SCHEDULE_TEMPLATE_NAME=
META_WHATSAPP_CALL_SCHEDULE_TEMPLATE_LANG=
META_WHATSAPP_CALL_SCHEDULE_TEMPLATE_COMPONENTS_JSON=

# ─── Criptografia (tokens em canal / secrets) ─────────────────
# Chave AES-256-GCM usada por src/lib/crypto/secrets.ts para
# encriptar tokens em Channel.config, MFA secrets, etc.
# Gere com: openssl rand -base64 32   (44 chars, 32 bytes)
# OBRIGATORIA fora de dev local. O codigo aceita KEYRING_SECRET
# (canonico) OU ENCRYPTION_KEY (alias legado) para nao quebrar
# ambientes ja configurados; prefira KEYRING_SECRET em setups novos.
KEYRING_SECRET=
# ENCRYPTION_KEY=  # alias aceito para back-compat

# ─── Marketplace de widgets (SSO p/ iframes de parceiros) ─────
# Segredo HMAC usado pra assinar/verificar o JWT SSO emitido em
# /api/widgets/:slug/sso-token e validado em
# /api/public/widgets/sso/verify. Deve ter >=32 chars e ser
# INDEPENDENTE do AUTH_SECRET (escopo isolado — comprometer este
# segredo nao expoe sessoes do CRM). Em dev, cai num fallback
# derivado de AUTH_SECRET se ausente.
WIDGET_SSO_SECRET=

# ─── Automação / filas ─────────────────────────────────────────
# `external` → API só enfileira em `automation-jobs`; o processo
# `APP_MODE=worker-automation` consome e executa. Qualquer outro valor
# (ou vazio) → execução inline no processo chamador (dev local).
# Em external, se Redis estiver indisponível a API FALHA (não faz fallback inline).
AUTOMATION_WORKER_MODE=
# Concurrency do worker-automation (jobs em paralelo no mesmo processo).
# Manter ≤ DB_POOL_MAX do serviço (default 4).
AUTOMATION_WORKER_CONCURRENCY=4
# Rate limit opcional para o worker-automation (protege Meta Cloud API em
# campanhas/automação em massa). Deixe vazio/0 para desligar.
AUTOMATION_RATE_LIMIT_MAX=
AUTOMATION_RATE_LIMIT_DURATION=1000
# Retry dos jobs de automação (mesmo padrão dos outros workers).
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_BACKOFF_DELAY=3000
# TTL de contexto pausado sem `timeoutMs` no canvas (default 24h, 0 desliga).
# Sem isso o contexto fica RUNNING pra sempre e trava o 1º atendimento da IA.
AUTOMATION_PAUSED_CONTEXT_TTL_MS=
AI_AGENT_INACTIVITY_INTERVAL_MS=
AI_AGENT_INACTIVITY_WORKER=
# Check-in só-IA após silêncio (default 30min) e encerramento +30min. 0 no nudge desliga.
AI_AGENT_IDLE_NUDGE_MS=1800000
AI_AGENT_IDLE_CLOSE_AFTER_NUDGE_MS=1800000
SCHEDULED_MESSAGES_INTERVAL_MS=
SCHEDULED_MESSAGES_WORKER=
STALE_OUTBOUND_TIMEOUT_MS=
STALE_OUTBOUND_SWEEP_INTERVAL_MS=

# ─── BullMQ workers: Meta Webhook (offload da API) ───────
# Processamento assíncrono de webhooks Meta (status de campanha + mensagens).
# Default ligado: API valida assinatura, persiste MetaWebhookEvent, enfileira
# e responde 200. `META_WEBHOOK_ASYNC=0` volta ao processamento síncrono
# (rollback imediato sem redeploy do worker).
META_WEBHOOK_ASYNC=1
# Concurrency do worker-meta-webhook. DEVE ser ≤ DB_POOL_MAX do processo
# (default 4). Valor > pool → "timeout exceeded when trying to connect".
META_WEBHOOK_WORKER_CONCURRENCY=4
META_WEBHOOK_MAX_ATTEMPTS=5
META_WEBHOOK_BACKOFF_DELAY=2000

# ─── Pool Postgres (por processo Node) — EasyPanel checklist ───
# Erro "timeout exceeded when trying to connect" = pg-pool esgotado
# (DB_POOL_CONN_TIMEOUT_MS), NÃO timeout de entrega Meta nem curl 28 do deploy.
#
# Defaults no código (se DB_POOL_MAX omitido):
#   api                 → 20  (inbox/board; drain da fila foi pro worker —
#                              não baixar para 10 sem medir ociosidade)
#   worker-whatsapp     → 8
#   worker-campaigns    → 16
#   worker-distribution → 4   (honor DB_POOL_MAX se setado)
#   demais worker-*     → 4
#
# Valores recomendados por serviço EasyPanel (mesmo DATABASE_URL):
#   backend-api:            DB_POOL_MAX=20  DB_POOL_CONN_TIMEOUT_MS=8000
#   worker-whatsapp:        DB_POOL_MAX=8
#   worker-campaigns:       DB_POOL_MAX=16  CAMPAIGN_SEND_RATE_MAX=30  CAMPAIGN_SEND_CONCURRENCY=4
#   worker-meta-webhook:    DB_POOL_MAX=4   META_WEBHOOK_WORKER_CONCURRENCY=4
#   worker-automation:      DB_POOL_MAX=4   AUTOMATION_WORKER_CONCURRENCY=4
# Orçamento ≈ 20+8+16+4+4 = 52 + folga (scripts/admin) em max_connections=100.
# Confirmar no log de boot: "[prisma-base] pool ready APP_MODE=..."
# Confirmar esgotamento: "[prisma-base] pool exhausted APP_MODE=... waiting=..."
# DB_POOL_MAX=
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONN_TIMEOUT_MS=8000
# DB_STATEMENT_TIMEOUT_MS=30000

# ─── BullMQ workers: campanhas (worker-campaigns) ─────────────
# Cap real de blast: CAMPAIGN_SEND_RATE_MAX (msgs/s) + CAMPAIGN_SEND_CONCURRENCY.
# WHATSAPP_RATE_LIMIT_* é teto BullMQ adicional (não subir acima do cap).
CAMPAIGN_SEND_RATE_MAX=30
CAMPAIGN_SEND_RATE_DEFAULT=20
CAMPAIGN_SEND_CONCURRENCY=4
WHATSAPP_RATE_LIMIT_MAX=30
WHATSAPP_RATE_LIMIT_DURATION=1000
WHATSAPP_MAX_ATTEMPTS=6
WHATSAPP_BACKOFF_DELAY=3000

# ─── BullMQ workers: Leads (operações em massa de Deals) ──────
# Concurrency = quantos jobs em paralelo no MESMO processo worker.
# Cada job processa seus chunks sequencialmente (chunks de 50 deals).
LEADS_BULK_CONCURRENCY=5
LEADS_BULK_MAX_ATTEMPTS=5
LEADS_BULK_BACKOFF_DELAY=5000
# Fila de espera da Distribuição — APP_MODE=worker-distribution (e ainda
# worker-leads na Phase A). Concurrency 1.
# DISTRIBUTION_DRAIN_CONCURRENCY=1
# DISTRIBUTION_DRAIN_MAX_ATTEMPTS=3
# DISTRIBUTION_DRAIN_BACKOFF_DELAY=2000

# ─── Presença / WhatsApp health ────────────────────────────────
PRESENCE_AWAY_MINUTES=
PRESENCE_OFFLINE_MINUTES=
WHATSAPP_HEALTH_TTL_MS=

# ─── IA (OpenAI / Anthropic / transcribe) ─────────────────────
OPENAI_API_KEY=
AI_DEFAULT_MODEL=
AI_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
AUTOMATION_COPILOT_MODEL=
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_TRANSCRIBE_MODEL=

# ─── Cron ─────────────────────────────────────────────────────
CRON_SECRET=

# ─── Observabilidade / Metrics ───────────────────────────────
# Bearer token exigido por GET /api/metrics (Prometheus scrape).
# Sem valor, o endpoint responde 503 — sinal explicito de "desligado".
# Use o MESMO valor no Prometheus (METRICS_TOKEN_DEV/PROD) do
# stack em infra/monitoring/.
METRICS_TOKEN=

# URL da HTTP API do Prometheus, usada por /api/admin/perf-report
# e /api/cron/perf-snapshot para consultas PromQL. Ex:
# http://prometheus:9090 (dentro da rede crm-monitoring).
PROMETHEUS_URL=
# Opcional: bearer token do Prometheus (se protegido por reverse proxy).
PROMETHEUS_TOKEN=

# OpenTelemetry OTLP (opcional; ver src/lib/otel-sdk.ts).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crm-eduit
OTEL_SERVICE_VERSION=

# ─── Mídia / timezone ─────────────────────────────────────────
DEFAULT_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=

# ─── Telefonia Api4com ─────────────────────────────────────────
# Token ADMIN com ttl:-1 da conta de serviço dedicada (gerar via
# POST /users/accessTokens em ambiente fora-do-app). Trocar a senha
# do usuário admin INVALIDA este token. Ver docs/PLAN-api4com.md.
API4COM_SERVICE_TOKEN=
# Identificador do gateway no PATCH /integrations e em metadata.gateway
# de cada /dialer. Default por org pode ser ajustado em CallProviderConfig.
API4COM_GATEWAY=
# Versão do payload do webhook. Docs oficiais suportam apenas `1.8`.
API4COM_WEBHOOK_VERSION=1.8

# ─── Cockpit monitor (URL dedicada, ex. banco-agente-ia-acad…) ───
# Mesmo segredo no serviço estático deploy/cockpit-monitor (COCKPIT_ACCESS_SECRET).
# No hub EasyPanel também: BACKEND_PROD_URL, BACKEND_DEV_URL, FRONTEND_PROD_URL, FRONTEND_DEV_URL
# COCKPIT_ORGANIZATION_ID=cuid da org Cruzeiro do Sul em prod.
# COCKPIT_ALLOWED_ORIGINS=https://banco-agente-ia-acad.6tqx2r.easypanel.host
COCKPIT_ACCESS_SECRET=
COCKPIT_ORGANIZATION_ID=
COCKPIT_ALLOWED_ORIGINS=
# Embed no CRM (/ai-agents). Opcional — se vazio, usa WIDGET_SSO_SECRET derivado.
# COCKPIT_EMBED_SECRET=
# Serviço nginx (agente_ia_acad), não este backend:
#   COCKPIT_PARENT_ORIGINS=https://crm-dev-frontend....,https://*.seudominio.com
#   COCKPIT_ALLOWED_API_BASES=https://crm-dev-backend....
